{
  "_comment": "Model pool for the gateway. Each model has an ordered list of routes: the direct provider first, then OpenRouter as a fallback. Tiers: economy < standard < premium; lighter tiers count as less compute effort (1/3/8 per token), so the router uses them when they are good enough. Quality is a 1-10 relative score used by the 'quality' and 'balanced' strategies. auto_improve_every_hours runs the optimizer on a timer while the GUI or Android app is running (0 disables).",
  "defaults": {
    "expected_output_tokens": 600,
    "request_timeout_s": 60,
    "max_retries_per_route": 2,
    "circuit_breaker_failures": 3,
    "circuit_breaker_cooldown_s": 120,
    "cache_ttl_s": 900,
    "strategy": "balanced",
    "auto_improve_every_n_requests": 50,
    "auto_improve_every_hours": 6,
    "repo_sync_every_hours": 6,
    "cost": {"free_only": true},
    "nodes": {"scan_every_minutes": 60, "lan_scan": true, "max_models_per_node": 12, "max_free_openrouter": 20},
    "learning": {
      "explore_rate": 0.1,
      "prior_strength": 4,
      "recency_window": 200,
      "weights": {
        "quality": 1.0,
        "effort": 0.35,
        "latency": 0.15
      },
      "judge_sample_rate": 0.0,
      "judge_model": "deepseek-v4-flash"
    },
    "improvement": {
      "min_samples": 20,
      "target_quality": 0.72,
      "upgrade_margin": 0.15,
      "rollback_drop": 0.1,
      "quarantine_reliability": 0.5,
      "quarantine_s": 3600
    },
    "compression": {
      "enabled": true,
      "trigger_tokens": 120000,
      "keep_last_turns": 6,
      "summarize_with_model": true,
      "summary_max_tokens": 800,
      "map_chunk_tokens": 60000,
      "map_max_chunks": 24
    },
    "storage": {
      "max_db_mb": 50,
      "max_raw_rows": 200000,
      "retain_raw_days": 30
    },
    "max_attempts_per_request": 8,
    "request_deadline_s": 120
  },
