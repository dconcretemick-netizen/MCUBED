<?xml version="1.0" encoding="utf-8"?>
<!-- Google Play flavor overlay: strip the permissions Play only allows for core
     device-management purposes. The Play build never installs APKs itself (Play
     delivers updates) and does not ask for a battery-optimization exemption. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />
</manifest>
