# Copy to .env and fill in only the providers you use. Never commit .env.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
VERTEXAI_PROJECT=
# Required when serving the dashboard beyond localhost (e.g. --host 0.0.0.0)
GATEWAY_GUI_TOKEN=
# 1 = stdlib-only mode, everything routed through OpenRouter (recommended on Android)
GATEWAY_LITE=0
