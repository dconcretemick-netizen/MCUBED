# Copy to .env (never commit it) and export before running, e.g.  set -a; . ./.env; set +a
# Any subset works: the gateway only routes to providers whose keys are present.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Google Vertex AI uses Application Default Credentials (gcloud auth application-default login)
# or a service-account file:
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=

# Optional
GATEWAY_LITE=0          # 1 = stdlib-only Android mode (OpenRouter, plus direct OpenAI/DeepSeek)
GATEWAY_MOCK=0          # 1 = offline mock responses, no keys needed
GATEWAY_DB=gateway_usage.db
GATEWAY_GUI_TOKEN=      # required token for the GUI when served on 0.0.0.0

# Fine-grained GitHub token (read-only) to auto-add your repositories
GITHUB_TOKEN=
